# Copy to .env and fill in. Never commit the real .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=rashadshoes
POSTGRES_USER=rashadshoes
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://rashadshoes:change-me@db:5432/rashadshoes

SHOP_NAME=Rashad Shoes
SHOP_CITY=Tripoli
# Digits only, international format: +961 3 123 456 -> 9613123456
SHOP_WHATSAPP=
SHOP_INSTAGRAM=rashad_shoes_tripoli
SHOP_CURRENCY=USD
SHOP_CURRENCY_SYMBOL=$
SHOP_LOW_STOCK_THRESHOLD=1
